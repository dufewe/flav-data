{
    "inspire-hep": "691576",
    "author": "Schael, S. and others",
    "collaboration": "ALEPH, DELPHI, L3, OPAL, SLD, LEP Electroweak Working Group, SLD Electroweak Group, SLD Heavy Flavour Group",
    "title": "Precision electroweak measurements on the Z resonance",
    "arxiv": "[hep-ex/0509008v1](https://arxiv.org/pdf/hep-ex/0509008.pdf)",
    "time": "2005-09-07",
    "abstract": "We report on the final electroweak measurements performed with data taken at the Z resonance by the experiments operating at SLC and LEP. The data consist of 17 million Z decays at LEP and 600 thousand Z decays by SLD. The mass and width of the Z boson, and its couplings to fermions are precisely measured: mZ = 91.1875 +- 0.0021 GeV, GammaZ = 2.4952 +- 0.0023 GeV, sin^2 theta_eff^lept = 0.23153 +- 0.00016. The number of light neutrino species is determined to be 2.9840 +- 0.0082.",
    "pdf": "https://arxiv.org/pdf/hep-ex/0509008.pdf",
    "transition-mode": "leptonic-decay",
    "data": {
        "e+.e-.2.Z.2.all": [
            {
                "obs@1": {
                    "name": "mZ",
                    "latex": "$m_{Z}$",
                    "value": "91.1875",
                    "error_upper": "0.0021",
                    "error_lower": "0.0021",
                    "unit": "GeV"
                },
                "obs@2": {
                    "name": "GammaZ",
                    "latex": "$\\Gamma_{Z}$",
                    "value": "2.4952",
                    "error_upper": "0.0023",
                    "error_lower": "0.0023",
                    "unit": "GeV"
                }
            }
        ],
        "e+.e-.2.Z.2.had": [
            {
                "obs@1": {
                    "name": "sigma_had0",
                    "latex": "$\\sigma_{had}^{0}$",
                    "value": "41.540",
                    "error_upper": "0.037",
                    "error_lower": "0.037",
                    "unit": "nb"
                }
            }
        ],
        "Z.2.nu.nubar": [
            {
                "obs@1": {
                    "name": "Nnu",
                    "latex": "$N_{\\nu}$",
                    "value": "2.9840",
                    "error_upper": "0.0082",
                    "error_lower": "0.0082"
                }
            }
        ],
        "Z.2.l+.l-": [
            {
                "obs@1": {
                    "name": "sin2theta_eff_lept",
                    "latex": "$\\sin^{2}\\theta_{eff}^{lept}$",
                    "value": "0.23153",
                    "error_upper": "0.00016",
                    "error_lower": "0.00016"
                },
                "obs@2": {
                    "name": "rho_lept",
                    "latex": "$\\rho_{\\ell}$",
                    "value": "1.0050",
